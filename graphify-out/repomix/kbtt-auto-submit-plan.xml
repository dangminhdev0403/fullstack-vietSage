  ACTIVE
  DISABLED
}

enum RoomStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  MAINTENANCE
  OUT_OF_SERVICE
  BLOCKED
  PROCESSING
}

enum RoomQRCodeStatus {
  ACTIVE
  INACTIVE
  EXPIRED
