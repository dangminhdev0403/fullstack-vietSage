  VIETSAGE_ADMIN
  HOTEL_STAFF
  PARTNER
}

enum TenantUserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum HotelStaffAssignmentStatus {
  ACTIVE
  REVOKED
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
  OPTIONS
}

enum UserRoleStatus {
  ACTIVE
  REVOKED
}

enum RoleStatus {
  ACTIVE
  DISABLED
}

enum RoleType {
  SYSTEM_TEMPLATE
  CUSTOM
}

enum AuthSessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
  COMPROMISED
}

enum AuthSessionRevokeReason {
  LOGOUT
  LOGOUT_ALL
  USER_DISABLED
  ROLE_CHANGED
  REFRESH_TOKEN_REPLAYED
  SESSION_REPLACED
