  cart      GuestCart          @relation(fields: [cartId], references: [id], onDelete: Cascade)
  service   MarketplaceService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([cartId, serviceId])
  @@index([cartId])
  @@index([serviceId])
}
