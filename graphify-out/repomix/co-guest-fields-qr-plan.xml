<file path="services/auth-service/prisma/schema.prisma">
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  LOCKED
  DISABLED
}

enum UserType {
  VIETSAGE_ADMIN
  HOTEL_STAFF
  PARTNER
}

enum TenantUserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum HotelStaffAssignmentStatus {
  ACTIVE
  REVOKED
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
  OPTIONS
}

enum UserRoleStatus {
  ACTIVE
  REVOKED
}

enum RoleStatus {
  ACTIVE
  DISABLED
}

enum AuthSessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
  COMPROMISED
}

enum AuthSessionRevokeReason {
  LOGOUT
  LOGOUT_ALL
  USER_DISABLED
  ROLE_CHANGED
  REFRESH_TOKEN_REPLAYED
  SESSION_REPLACED
  SECURITY_EVENT
  EXPIRED
}

enum HotelStatus {
  ACTIVE
  DISABLED
}

enum RoomStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  MAINTENANCE
  OUT_OF_SERVICE
  BLOCKED
  PROCESSING
}

enum RoomQRCodeStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  REVOKED
}

enum GuestStayStatus {
  RESERVED
  CHECKED_IN
  ACTIVE
  CHECKOUT_PENDING
  CHECKED_OUT
  CANCELLED
}

enum ReservationStatus {
  CONFIRMED
  ARRIVAL_READY
  CHECKED_IN
  CANCELLED
  NO_SHOW
}

enum GuestSessionStatus {
  CREATED
  ACTIVE
  IDLE
  EXPIRED
  CLOSED
}

enum GuestRequestStatus {
  NEW
  CONFIRMED
  PENDING
  ACCEPTED
  ON_THE_WAY
  IN_PROGRESS
  COMPLETED
  REJECTED
  CREATED
  ACKNOWLEDGED
  CANCELLED
  FAILED
}

enum GuestRequestPriority {
  NORMAL
  URGENT
}

enum GuestRequestActorType {
  GUEST
  STAFF
  SYSTEM
}

enum NotificationProvider {
  TELEGRAM
}

enum GuestRequestNotificationStatus {
  PENDING
  SENT
  FAILED
}

enum ServiceCatalogStatus {
  ACTIVE
  DISABLED
}

enum CategoryPriceUpdateMode {
  CATEGORY_ONLY
  OVERRIDE_ALL_ITEMS
}

enum DomainEventStatus {
  PENDING
  PROCESSED
  FAILED
}

enum FolioStatus {
  OPEN
  CHECKOUT_PENDING
  CLOSED
  VOID
}

enum FolioItemType {
  SERVICE
  ROOM_CHARGE
  MANUAL_CHARGE
  DISCOUNT
  ADJUSTMENT
}

enum FolioItemSourceType {
  GUEST_REQUEST
  ROOM
  STAY
  MANUAL
  SYSTEM
}

enum GuestRequestBillingPostStatus {
  NONE
  POSTED
  FAILED
}

enum InvoiceStatus {
  ISSUED
  PAID
  VOID
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  MOMO
  VNPAY
  STRIPE
  MANUAL
}

enum PaymentProvider {
  MANUAL
  MOMO
  VNPAY
  STRIPE
  BANK_TRANSFER
}

enum PlatformBillingContractStatus {
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum PlatformBillingPeriodStatus {
  DRAFT
  FINALIZED
  VOID
}

enum EmergencyLocationSource {
  GPS
  QR
  INVITE
  HOST_SELECTED
  GUEST_SELECTED
  MANUAL_ADDRESS
  TENANT_DEFAULT
  IP_DERIVED
  UNKNOWN
}

enum EmergencyLocationConfidence {
  HIGH
  MEDIUM
  LOW
  UNKNOWN
}

enum EmergencyCallLifecycleStatus {
  ATTEMPTED
  ROUTED
  RINGING
  CONNECTED
  FAILED
  ABANDONED
  COMPLETED
}

enum EmergencyIncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EmergencyIncidentStatus {
  OPEN
  ESCALATING
  ACKNOWLEDGED
  MONITORING
  RESOLVED
  REOPENED
}

enum EmergencyNotificationStatus {
  PENDING
  SENT
  FAILED
  ACKNOWLEDGED
}

enum EmergencyNotificationType {
  INITIAL
  SEVERITY_ESCALATION
  ROOM_UPDATE
  FAILURE
  RESOLUTION
  REOPENED
}

model User {
  id                    String                 @id @default(cuid())
  email                 String                 @unique @db.VarChar(320)
  passwordHash          String                 @db.VarChar(255)
  fullName              String                 @db.VarChar(120)
  status                UserStatus             @default(ACTIVE)
  userType              UserType
  lastLoginAt           DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  userRoles             UserRole[]
  refreshTokens         RefreshToken[]
  authSessions          AuthSession[]
  tenantUsers           TenantUser[]
  hotelAssignments      HotelStaffAssignment[] @relation("HotelStaffAssignmentUser")
  assignedHotelStaff    HotelStaffAssignment[] @relation("HotelStaffAssignmentAssignedBy")
  revokedHotelStaff     HotelStaffAssignment[] @relation("HotelStaffAssignmentRevokedBy")
  auditLogs             AuditLog[]             @relation("AuditActor")
  createdStays          GuestStay[]            @relation("GuestStayCreatedBy")
  closedStays           GuestStay[]            @relation("GuestStayClosedBy")
  assignedGuestRequests GuestRequest[]         @relation("GuestRequestAssignedTo")
  guestRequestEvents    GuestRequestEvent[]    @relation("GuestRequestEventActor")
  sentGuestMessages     GuestMessage[]         @relation("GuestMessageStaffSender")
  createdFolios         Folio[]                @relation("FolioCreatedBy")
  closedFolios          Folio[]                @relation("FolioClosedBy")
  postedFolioItems      FolioItem[]            @relation("FolioItemPostedBy")
  voidedFolioItems      FolioItem[]            @relation("FolioItemVoidedBy")
  issuedInvoices        Invoice[]              @relation("InvoiceIssuedBy")
  paidInvoices          Invoice[]              @relation("InvoicePaidBy")
  voidedInvoices        Invoice[]              @relation("InvoiceVoidedBy")
  createdPayments       Payment[]              @relation("PaymentCreatedBy")
}

model Role {
  id              String           @id @default(cuid())
  code            String           @unique @db.VarChar(80)
  name            String           @db.VarChar(120)
  description     String?          @db.VarChar(255)
  status          RoleStatus       @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@index([status])
}

model Permission {
  id              String           @id @default(cuid())
  method          HttpMethod
  moduleKey       String           @db.VarChar(80)
  path            String           @db.VarChar(255)
  description     String           @db.VarChar(255)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]

  @@unique([method, path])
  @@index([moduleKey, method, path])
}

model Code {
  id           String   @id @default(cuid())
  name         String   @unique @db.VarChar(80)
  sequenceNext Int      @default(1)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([name])
  @@index([isActive])
}

model UserRole {
  id           String         @id @default(cuid())
  userId       String
  roleId       String
  status       UserRoleStatus @default(ACTIVE)
  assignedAt   DateTime       @default(now())
  assignedById String?
  revokedAt    DateTime?
  revokedById  String?
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role           @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId, status])
  @@index([roleId, status])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique @db.VarChar(255)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuthSession {
  id                 String                    @id @default(cuid())
  userId             String
  roleId             String
  status             AuthSessionStatus         @default(ACTIVE)
  currentRefreshHash String                    @unique @db.VarChar(255)
  refreshFamilyId    String                    @db.VarChar(64)
  version            Int                       @default(1)
  idleExpiresAt      DateTime
  absoluteExpiresAt  DateTime
  lastUsedAt         DateTime                  @default(now())
  rotatedAt          DateTime?
  revokedAt          DateTime?
  revokeReason       AuthSessionRevokeReason?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHistory     AuthRefreshTokenHistory[]
  refreshIdempotency AuthRefreshIdempotency[]

  @@index([userId, status])
  @@index([refreshFamilyId, status])
  @@index([status, idleExpiresAt])
  @@index([status, absoluteExpiresAt])
}

model AuthRefreshTokenHistory {
  id        String      @id @default(cuid())
  sessionId String
  tokenHash String      @unique @db.VarChar(255)
  expiresAt DateTime
  createdAt DateTime    @default(now())
  session   AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([expiresAt])
}

model AuthRefreshIdempotency {
  id                 String      @id @default(cuid())
  sessionId          String
  idempotencyKey     String      @db.VarChar(64)
  requestFingerprint String      @db.VarChar(64)
  encryptedResult    String      @db.Text
  expiresAt          DateTime
  createdAt          DateTime    @default(now())
  session            AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, idempotencyKey])
  @@index([expiresAt])
}

model Tenant {
  id                  String               @id @default(cuid())
  code                String               @unique @db.VarChar(80)
  name                String               @db.VarChar(160)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  tenantUsers         TenantUser[]
  auditLogs           AuditLog[]
  hotels              Hotel[]
  emergencyLocations  EmergencyLocation[]
  emergencyCallEvents EmergencyCallEvent[]
  emergencyIncidents  EmergencyIncident[]
}

model TenantUser {
  id        String           @id @default(cuid())
  tenantId  String
  userId    String
  status    TenantUserStatus @default(INVITED)
  joinedAt  DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId, status])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  tenantId   String
  action     String   @db.VarChar(120)
  entityType String   @db.VarChar(120)
  entityId   String?  @db.VarChar(120)
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([actorId, createdAt])
  @@index([tenantId, createdAt])
}

model Hotel {
  id                       String                        @id @default(cuid())
  tenantId                 String
  name                     String                        @db.VarChar(160)
  code                     String                        @db.VarChar(80)
  brandSettings            Json?
  googleSheetId            String?                       @unique @db.VarChar(200)
  timezone                 String                        @default("Asia/Ho_Chi_Minh") @db.VarChar(80)
  status                   HotelStatus                   @default(ACTIVE)
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt
  tenant                   Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rooms                    Room[]
  roomQRCodes              RoomQRCode[]
  guestStays               GuestStay[]
  reservations             Reservation[]
  guestSessions            GuestSession[]
  guestRequests            GuestRequest[]
  guestMessageThreads      GuestMessageThread[]
  guestMessages            GuestMessage[]
  notificationRoutes       NotificationRoute[]
  requestEvents            GuestRequestEvent[]
  serviceCategories        HotelServiceCategory[]
  serviceItems             HotelServiceItem[]
  domainEvents             DomainEvent[]
  folios                   Folio[]
  folioItems               FolioItem[]
  invoices                 Invoice[]
  payments                 Payment[]
  paymentTransactions      PaymentTransaction[]
  staffAssignments         HotelStaffAssignment[]
  emergencyLocations       EmergencyLocation[]
  emergencyCallEvents      EmergencyCallEvent[]
  emergencyIncidents       EmergencyIncident[]
  biometricPairings        BiometricWorkstationPairing[]
  biometricWorkstations    BiometricWorkstation[]
  platformBillingContracts      PlatformBillingContract[]
  platformUsages                PlatformUsage[]
  platformBillableDays          PlatformBillableDay[]
  platformBillingDailySummaries PlatformBillingDailySummary[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
}

model PlatformBillingContract {
  id                    String                            @id @default(cuid())
  hotelId               String
  status                PlatformBillingContractStatus     @default(ACTIVE)
  onboardedAt           DateTime
  billingStartedAt      DateTime
  reconciledThroughDate DateTime?                         @db.Date
  createdAt             DateTime                          @default(now())
  updatedAt             DateTime                          @updatedAt
  hotel                 Hotel                             @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  revisions             PlatformBillingContractRevision[]
  billableDays          PlatformBillableDay[]
  periods               PlatformBillingPeriod[]
  adjustments           PlatformBillingAdjustment[]
  summaries             PlatformBillingDailySummary[]

  @@index([hotelId, status])
  @@index([status, reconciledThroughDate, id])
}

model PlatformBillingContractRevision {
  id               String                  @id @default(cuid())
  contractId       String
  effectiveFrom    DateTime                @db.Date
  starTierSnapshot Int
  roomDayUnitPrice Decimal                 @db.Decimal(12, 2)
  currency         String                  @default("VND") @db.VarChar(3)
  paymentTermDays  Int                     @default(7)
  createdByUserId  String?
  createdAt        DateTime                @default(now())
  contract         PlatformBillingContract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  billableDays     PlatformBillableDay[]

  @@unique([contractId, effectiveFrom])
  @@index([contractId, effectiveFrom])
}

model PlatformUsage {
  id                    String    @id @default(cuid())
  hotelId               String
  subjectType           String    @default("ROOM") @db.VarChar(32)
  subjectId             String    @db.VarChar(120)
  usageKind             String    @default("STAY") @db.VarChar(32)
  sourceType            String    @default("GUEST_STAY") @db.VarChar(32)
  sourceId              String    @db.VarChar(120)
  occurrence            Int       @default(1)
  startedAt             DateTime
  endedAt               DateTime?
  durationMinutes       Int?
  hotelTimezoneSnapshot String    @db.VarChar(80)
  createdAt             DateTime  @default(now())
  closedAt              DateTime?
  hotel                 Hotel     @relation(fields: [hotelId], references: [id], onDelete: Restrict)

  @@unique([sourceType, sourceId, occurrence])
  @@index([hotelId, startedAt, endedAt])
  @@index([subjectType, subjectId, startedAt])
}

model PlatformBillableDay {
  id                    String                          @id @default(cuid())
  contractId            String
  contractRevisionId    String
  hotelId               String
  subjectType           String                          @default("ROOM") @db.VarChar(32)
  subjectId             String                          @db.VarChar(120)
  serviceDate           DateTime                        @db.Date
  hotelTimezoneSnapshot String                          @db.VarChar(80)
  starTierSnapshot      Int
  unitPrice             Decimal                         @db.Decimal(12, 2)
  quantity              Int                             @default(1)
  amount                Decimal                         @db.Decimal(12, 2)
  currency              String                          @default("VND") @db.VarChar(3)
  calculationVersion    Int                             @default(1)
  sourceWindowStart     DateTime
  sourceWindowEnd       DateTime
  createdAt             DateTime                        @default(now())
  contract              PlatformBillingContract         @relation(fields: [contractId], references: [id], onDelete: Restrict)
  contractRevision      PlatformBillingContractRevision @relation(fields: [contractRevisionId], references: [id], onDelete: Restrict)
  hotel                 Hotel                           @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  adjustments           PlatformBillingAdjustment[]

  @@unique([contractId, subjectType, subjectId, serviceDate])
  @@index([contractId, serviceDate])
  @@index([hotelId, serviceDate])
  @@index([contractRevisionId, serviceDate])
}

model PlatformBillingPeriod {
  id                String                      @id @default(cuid())
  contractId        String
  periodStart       DateTime                    @db.Date
  periodEnd         DateTime                    @db.Date
  status            PlatformBillingPeriodStatus @default(DRAFT)
  dueAt             DateTime?
  chargeCount       Int                         @default(0)
  subtotal          Decimal                     @default(0) @db.Decimal(12, 2)
  adjustmentTotal   Decimal                     @default(0) @db.Decimal(12, 2)
  total             Decimal                     @default(0) @db.Decimal(12, 2)
  currency          String                      @default("VND") @db.VarChar(3)
  finalizedAt       DateTime?
  finalizedByUserId String?
  snapshotHash      String?                     @db.VarChar(120)
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  contract          PlatformBillingContract     @relation(fields: [contractId], references: [id], onDelete: Restrict)
  adjustments       PlatformBillingAdjustment[]
  settlements       PlatformBillingSettlement[]

  @@unique([contractId, periodStart, periodEnd])
  @@index([contractId, status, periodStart, periodEnd])
  @@index([dueAt, status])
}

model PlatformBillingAdjustment {
  id                   String                   @id @default(cuid())
  contractId           String
  billableDayId        String?
  periodId             String?
  amount               Decimal                  @db.Decimal(12, 2)
  currency             String                   @default("VND") @db.VarChar(3)
  reasonCode           String                   @db.VarChar(80)
  note                 String?                  @db.VarChar(500)
  actorUserId          String?
  reversesAdjustmentId String?
  idempotencyKey       String                   @db.VarChar(120)
  createdAt            DateTime                 @default(now())
  contract             PlatformBillingContract  @relation(fields: [contractId], references: [id], onDelete: Restrict)
  billableDay          PlatformBillableDay?     @relation(fields: [billableDayId], references: [id], onDelete: SetNull)
  period               PlatformBillingPeriod?   @relation(fields: [periodId], references: [id], onDelete: SetNull)

  @@unique([contractId, idempotencyKey])
  @@index([contractId, createdAt])
  @@index([periodId, createdAt])
}

model PlatformBillingSettlement {
  id             String                @id @default(cuid())
  periodId       String
  amount         Decimal               @db.Decimal(12, 2)
  method         String                @default("BANK_TRANSFER") @db.VarChar(40)
  reference      String?               @db.VarChar(160)
  paidAt         DateTime              @default(now())
  idempotencyKey String                @db.VarChar(120)
  actorUserId    String?
  createdAt      DateTime              @default(now())
  period         PlatformBillingPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)

  @@unique([periodId, idempotencyKey])
  @@index([periodId, createdAt])
}

model PlatformBillingDailySummary {
  id                String                  @id @default(cuid())
  serviceDate       DateTime                @db.Date
  hotelId           String
  contractId        String
  billableRoomCount Int                     @default(0)
  grossAmount       Decimal                 @default(0) @db.Decimal(12, 2)
  adjustmentAmount  Decimal                 @default(0) @db.Decimal(12, 2)
  netAmount         Decimal                 @default(0) @db.Decimal(12, 2)
  updatedAt         DateTime                @updatedAt
  contract          PlatformBillingContract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  hotel             Hotel                   @relation(fields: [hotelId], references: [id], onDelete: Restrict)

  @@unique([contractId, serviceDate])
  @@index([serviceDate])
  @@index([hotelId, serviceDate])
}

model HotelStaffAssignment {
  id           String                     @id @default(cuid())
  userId       String
  hotelId      String
  status       HotelStaffAssignmentStatus @default(ACTIVE)
  assignedAt   DateTime                   @default(now())
  assignedById String?
  revokedAt    DateTime?
  revokedById  String?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  user         User                       @relation("HotelStaffAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  hotel        Hotel                      @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  assignedBy   User?                      @relation("HotelStaffAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  revokedBy    User?                      @relation("HotelStaffAssignmentRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  @@unique([userId, hotelId])
  @@index([userId, status])
  @@index([hotelId, status])
}

model BiometricWorkstationPairing {
  id         String    @id @default(cuid())
  codeHash   String    @unique @db.Char(64)
  hotelId    String
  operatorId String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  hotel      Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId, expiresAt])
}

model BiometricWorkstation {
  id         String    @id @default(cuid())
  tokenHash  String    @unique @db.Char(64)
  hotelId    String
  pairedAt   DateTime  @default(now())
  lastSeenAt DateTime
  expiresAt  DateTime
  revokedAt  DateTime?
  hotel      Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId, revokedAt, expiresAt, lastSeenAt])
}

model Room {
  id                    String               @id @default(cuid())
  hotelId               String
  code                  String               @unique @db.VarChar(80)
  roomNumber            String               @db.VarChar(40)
  floor                 String?              @db.VarChar(40)
  type                  String?              @db.VarChar(80)
  price                 Decimal?             @db.Decimal(12, 2)
  maxActiveGuestDevices Int?
  status                RoomStatus           @default(AVAILABLE)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  hotel                 Hotel                @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  qrCodes               RoomQRCode[]
  guestStays            GuestStay[]
  reservations          Reservation[]
  guestSessions         GuestSession[]
  guestRequests         GuestRequest[]
  guestMessageThreads   GuestMessageThread[]
  guestMessages         GuestMessage[]
  folios                Folio[]
  folioItems            FolioItem[]
  emergencyCallEvents   EmergencyCallEvent[]

  @@unique([hotelId, roomNumber])
  @@index([hotelId, status])
}

model RoomQRCode {
  id            String           @id @default(cuid())
  hotelId       String
  roomId        String
  publicCode    String           @unique @db.VarChar(120)
  status        RoomQRCodeStatus @default(INACTIVE)
  version       Int              @default(1)
  activatedAt   DateTime?
  deactivatedAt DateTime?
  expiresAt     DateTime?
  revokedAt     DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  hotel         Hotel            @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  room          Room             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  guestSessions GuestSession[]

  @@index([roomId, status])
  @@index([hotelId, status])
}

model Reservation {
  id                String            @id @default(cuid())
  hotelId           String
  roomId            String?
  reservationCode   String            @db.VarChar(80)
  guestDisplayName  String            @db.VarChar(120)
  guestPhone        String?           @db.VarChar(40)
  status            ReservationStatus @default(CONFIRMED)
  plannedCheckInAt  DateTime
  plannedCheckOutAt DateTime
  assignedAt        DateTime?
  assignedByUserId  String?
  checkedInAt       DateTime?
  checkedInByUserId String?
  createdByUserId   String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  hotel             Hotel             @relation(fields: [hotelId], references: [id], onDelete: Cascade)
