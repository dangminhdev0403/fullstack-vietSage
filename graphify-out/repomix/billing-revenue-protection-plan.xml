  PROCESSING
}

enum RoomQRCodeStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  REVOKED
}

enum GuestStayStatus {
  RESERVED
  CHECKED_IN
  ACTIVE
  CHECKOUT_PENDING
  CHECKED_OUT
  CANCELLED
}

enum ReservationStatus {
  CONFIRMED
