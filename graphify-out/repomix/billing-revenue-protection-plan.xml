  PATCH
  DELETE
  OPTIONS
}

enum UserRoleStatus {
  ACTIVE
  REVOKED
}

enum RoleStatus {
  ACTIVE
  DISABLED
}

enum AuthSessionStatus {
  ACTIVE
  REVOKED
