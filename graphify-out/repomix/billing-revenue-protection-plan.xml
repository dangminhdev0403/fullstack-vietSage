  CHECKED_IN
  CANCELLED
  NO_SHOW
}

enum GuestSessionStatus {
  CREATED
  ACTIVE
  IDLE
  EXPIRED
  CLOSED
}

enum GuestRequestStatus {
  NEW
  CONFIRMED
  PENDING
  ACCEPTED
