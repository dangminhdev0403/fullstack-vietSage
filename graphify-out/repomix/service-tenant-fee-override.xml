  emergencyLocation            EmergencyLocation?           @relation(fields: [emergencyLocationId], references: [id], onDelete: SetNull)
  notifications                EmergencyNotification[]
  hotelServiceItem             HotelServiceItem?            @relation(fields: [hotelServiceItemId], references: [id])
  hotelServiceItemId           String?

  @@index([tenantId, attemptedAt])
  @@index([hotelId, attemptedAt])
  @@index([incidentId, attemptedAt])
  @@index([providerCallId])
}

model EmergencyIncidentTimeline {
  id         String            @id @default(cuid())
  incidentId String
  eventType  String            @db.VarChar(80)
  note       String?           @db.VarChar(1000)
  metadata   Json?
  createdAt  DateTime          @default(now())
  incident   EmergencyIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
}

model EmergencyNotification {
  id              String                      @id @default(cuid())
  incidentId      String
  callEventId     String?
  recipientGroup  String                      @db.VarChar(120)
  deliveryChannel String                      @db.VarChar(80)
  status          EmergencyNotificationStatus @default(PENDING)
  type            EmergencyNotificationType   @default(INITIAL)
  retryCount      Int                         @default(0)
  lastAttemptAt   DateTime?
  acknowledgedAt  DateTime?
  payload         Json?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  incident        EmergencyIncident           @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  callEvent       EmergencyCallEvent?         @relation(fields: [callEventId], references: [id], onDelete: SetNull)

  @@index([incidentId, status])
  @@index([callEventId])
}

enum LocalPartnerStatus {
  ACTIVE
  DISABLED
}

enum LocalPartnerOfferStatus {
  ACTIVE
  EXPIRED
  DISABLED
}

enum LocalPartnerOfferDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_GIFT
  SPECIAL_PRICE
}

enum LocalPartnerBookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum LocalPartnerInteractionType {
  VIEW_DETAIL
  CLICK_MAP
  CLICK_CALL
  CLICK_ZALO
  CLAIM_OFFER
  BOOKING_REQUEST
}

model LocalPartnerCategory {
  id          String         @id @default(cuid())
  code        String         @unique @db.VarChar(80)
  nameVi      String         @db.VarChar(120)
  nameEn      String         @db.VarChar(120)
  icon        String         @db.VarChar(80)
  sortOrder   Int            @default(0)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  partners    LocalPartner[]

  @@index([sortOrder, isActive])
}

model LocalPartner {
  id                 String                       @id @default(cuid())
  hotelId            String
  categoryId         String
  name               String                       @db.VarChar(160)
  description        String?                      @db.VarChar(1000)
  address            String                       @db.VarChar(255)
  latitude           Float?
  longitude          Float?
  distanceMeters     Int?
  phone              String?                      @db.VarChar(40)
  zaloUrl            String?                      @db.VarChar(255)
  websiteUrl         String?                      @db.VarChar(255)
  googleMapUrl       String?                      @db.VarChar(500)
  coverImageUrl      String?                      @db.VarChar(500)
  images             String[]
  operatingHours     String?                      @db.VarChar(160)
  status             LocalPartnerStatus           @default(ACTIVE)
  isFeatured         Boolean                      @default(false)
  sortOrder          Int                          @default(0)
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  hotel              Hotel                        @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  category           LocalPartnerCategory         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  offers             LocalPartnerOffer[]
  bookingRequests    LocalPartnerBookingRequest[]
  interactionLogs    LocalPartnerInteractionLog[]

  @@index([hotelId, status, sortOrder])
  @@index([categoryId, status])
}

model LocalPartnerOffer {
  id              String                        @id @default(cuid())
  partnerId       String
  title           String                        @db.VarChar(160)
  description     String?                       @db.VarChar(500)
  discountCode    String?                       @db.VarChar(80)
  discountType    LocalPartnerOfferDiscountType @default(PERCENTAGE)
  discountValue   Float?
  termsCondition  String?                       @db.VarChar(500)
  validFrom       DateTime?
  validTo         DateTime?
  status          LocalPartnerOfferStatus       @default(ACTIVE)
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt
  partner         LocalPartner                  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  bookingRequests LocalPartnerBookingRequest[]

  @@index([partnerId, status])
}

model LocalPartnerBookingRequest {
  id             String                    @id @default(cuid())
  hotelId        String
  stayId         String?
  partnerId      String
  offerId        String?
  guestName      String                    @db.VarChar(120)
  roomNumber     String                    @db.VarChar(40)
  guestPhone     String                    @db.VarChar(40)
  serviceType    String                    @db.VarChar(120)
  bookingTime    DateTime?
  numberOfGuests Int?
  notes          String?                   @db.VarChar(500)
  status         LocalPartnerBookingStatus @default(PENDING)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  hotel          Hotel                     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  stay           GuestStay?                @relation(fields: [stayId], references: [id], onDelete: SetNull)
  partner        LocalPartner              @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  offer          LocalPartnerOffer?        @relation(fields: [offerId], references: [id], onDelete: SetNull)

  @@index([hotelId, status, createdAt])
  @@index([partnerId, status])
  @@index([stayId])
}

model LocalPartnerInteractionLog {
  id          String                      @id @default(cuid())
  hotelId     String
  stayId      String?
  partnerId   String
  actionType  LocalPartnerInteractionType
  createdAt   DateTime                    @default(now())
  hotel       Hotel                       @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  stay        GuestStay?                  @relation(fields: [stayId], references: [id], onDelete: SetNull)
  partner     LocalPartner                @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([hotelId, partnerId, createdAt])
  @@index([actionType, createdAt])
}

model ServiceTenantProfile {
  tenantId             String                    @id
  displayName          String                    @db.VarChar(160)
  description          String?                   @db.VarChar(1000)
  phone                String?                   @db.VarChar(40)
  address              String?                   @db.VarChar(255)
  googleMapsUrl        String?                   @db.VarChar(500)
  googleSheetsUrl      String?                   @db.VarChar(500)
  latitude             Decimal?                  @db.Decimal(9, 6)
  longitude            Decimal?                  @db.Decimal(9, 6)
  locationAccuracyMeters Float?                    @db.DoublePrecision
  locationSource     MarketplaceLocationSource?
  locationVerifiedAt DateTime?
  coverImageUrl        String?                   @db.VarChar(500)
  deliveryServiceFeeRate Decimal?                @db.Decimal(5, 2)
  status               MarketplaceRecordStatus   @default(DRAFT)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  categoryId           String?
  tenant               Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category             MarketplaceCategory?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([categoryId, status])
}

model MarketplaceCategory {
  id           String                           @id @default(cuid())
  code         String                           @unique @db.VarChar(80)
  importKey    String?                          @unique @db.VarChar(80)
  nameVi       String                           @db.VarChar(120)
  sortOrder    Int                              @default(0)
  isActive     Boolean                          @default(true)
  createdAt    DateTime                         @default(now())
  updatedAt    DateTime                         @updatedAt
  translations MarketplaceCategoryTranslation[]
  services     MarketplaceService[]
  serviceTenants ServiceTenantProfile[]

  @@index([isActive, sortOrder])
}

model MarketplaceCategoryTranslation {
  id         String              @id @default(cuid())
  categoryId String
  locale     String              @db.VarChar(10)
  name       String              @db.VarChar(120)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  category   MarketplaceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@index([locale])
}

model MarketplaceService {
  id                String                 @id @default(cuid())
  serviceTenantId   String
  importKey         String?              @db.VarChar(120)
  categoryId        String
  name              String                 @db.VarChar(160)
  description       String?                @db.VarChar(1000)
  unitPrice         Decimal                @db.Decimal(12, 2)
  pricingUnit       String?                @db.VarChar(32)
  currency          String                 @default("VND") @db.Char(3)
  imageUrls         String[]
  mode              MarketplaceServiceMode
  capacityAvailable Int?
  waitingMinutes    Int                    @default(0)
  status            MarketplaceRecordStatus @default(DRAFT)
  version           Int                    @default(1)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  serviceTenant     Tenant                 @relation("TenantMarketplaceServices", fields: [serviceTenantId], references: [id], onDelete: Cascade)
  category          MarketplaceCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orders            MarketplaceOrder[]
  orderItems        MarketplaceOrderItem[]
  cartItems         GuestCartItem[]
  translations      MarketplaceServiceTranslation[]

  @@unique([serviceTenantId, importKey])
  @@index([serviceTenantId, status, updatedAt])
  @@index([categoryId, status])
  @@index([status])
}

model MarketplaceServiceTranslation {
  id          String             @id @default(cuid())
  serviceId   String
  locale      String             @db.VarChar(10)
  name        String             @db.VarChar(160)
  description String?            @db.VarChar(1000)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  service     MarketplaceService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, locale])
  @@index([locale])
}

model HotelServiceLink {
  id              String                 @id @default(cuid())
  hotelId         String
  serviceTenantId String
  commissionRate  Decimal                @default(10.00) @db.Decimal(5, 2)
  status          HotelServiceLinkStatus @default(ACTIVE)
  sortOrder       Int                    @default(0)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  hotel           Hotel                  @relation("HotelServiceTenantLinks", fields: [hotelId], references: [id], onDelete: Cascade)
  serviceTenant   Tenant                 @relation("ServiceTenantHotelLinks", fields: [serviceTenantId], references: [id], onDelete: Cascade)

  @@unique([hotelId, serviceTenantId])
  @@index([hotelId, status, sortOrder])
  @@index([serviceTenantId, status])
}

model MarketplacePricingConfig {
  id                     String   @id @default("default") @db.VarChar(20)
  deliveryServiceFeeRate Decimal  @default(10.00) @db.Decimal(5, 2)
  updatedBy               String?  @db.VarChar(80)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

enum MarketplaceSettlementStatus {
  UNSETTLED
  READY_FOR_SETTLEMENT
  SETTLED
}

model MarketplaceSettlement {
  id                  String                      @id @default(cuid())
  orderId             String                      @unique
  hotelId             String
  serviceTenantId     String
  grossAmount         Decimal                     @db.Decimal(12, 2)
  commissionAmount    Decimal                     @db.Decimal(12, 2)
  netAmount           Decimal                     @db.Decimal(12, 2)
  currency            String                      @default("VND") @db.Char(3)
  status              MarketplaceSettlementStatus @default(UNSETTLED)
  settledAt           DateTime?
  settledBy           String?                     @db.VarChar(80)
  settledAmount       Decimal?                    @db.Decimal(12, 2)
  settlementReference String?                     @db.VarChar(120)
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  order               MarketplaceOrder            @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([hotelId, status])
  @@index([serviceTenantId, status])
}

enum HotelCoordinationStatus {
  RECEIVED
  ACKNOWLEDGED
  VOUCHER_ISSUED
}

enum ServiceVoucherStatus {
  ISSUED
  REDEEMED
  EXPIRED
  CANCELLED
}

model ServiceVoucher {
  id               String               @id @default(cuid())
  orderId          String               @unique
  hotelId          String
  serviceTenantId  String
  serviceId        String
  voucherNumber    String               @unique @db.VarChar(32)
  verificationCode String               @db.VarChar(64)
  qrTokenHash      String               @db.VarChar(128)
  status           ServiceVoucherStatus @default(ISSUED)
  issuedAt         DateTime             @default(now())
  expiresAt        DateTime?
  redeemedAt       DateTime?
  redeemedByUserId String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  order            MarketplaceOrder     @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([voucherNumber])
  @@index([serviceTenantId, status])
  @@index([hotelId, status])
}

model MarketplaceOrder {
  id                        String                    @id @default(cuid())
  orderNumber               String                    @unique @db.VarChar(32)
  idempotencyKey            String                    @db.VarChar(120)
  hotelId                   String
  stayId                    String
  serviceTenantId           String
  serviceId                 String
  quantity                  Int
  unitPriceSnapshot         Decimal                   @db.Decimal(12, 2)
  pricingUnitSnapshot       String?                   @db.VarChar(32)
  partnerSubtotal           Decimal                   @default(0) @db.Decimal(12, 2)
  hotelServiceFeeAmount     Decimal                   @default(0) @db.Decimal(12, 2)
  customerTotalAmount       Decimal                   @default(0) @db.Decimal(12, 2)
  totalAmount               Decimal                   @db.Decimal(12, 2)
  currency                  String                    @db.Char(3)
  serviceNameSnapshot       String                    @db.VarChar(160)
  serviceModeSnapshot       MarketplaceServiceMode
  waitingMinutesSnapshot    Int
  guestNote                 String?                   @db.VarChar(500)
  status                    MarketplaceOrderStatus    @default(PENDING)
  hotelCoordinationStatus   HotelCoordinationStatus   @default(RECEIVED)
  capacityReservationStatus CapacityReservationStatus
  version                   Int                       @default(1)
  completedAt               DateTime?
  cancelledAt               DateTime?
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  hotel                     Hotel                     @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  stay                      GuestStay                 @relation(fields: [stayId], references: [id], onDelete: Restrict)
  serviceTenant             Tenant                    @relation("ServiceTenantMarketplaceOrders", fields: [serviceTenantId], references: [id], onDelete: Restrict)
  service                   MarketplaceService        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  items                     MarketplaceOrderItem[]
  events                    MarketplaceOrderEvent[]
  revenue                   MarketplaceRevenueEntry?
  settlement                MarketplaceSettlement?
  voucher                   ServiceVoucher?

  @@unique([stayId, idempotencyKey])
  @@index([serviceTenantId, status, createdAt])
  @@index([hotelId, status, createdAt])
  @@index([stayId, createdAt])
}

model MarketplaceOrderItem {
  id                     String                 @id @default(cuid())
  orderId                String
  serviceId              String
  quantity               Int
  unitPriceSnapshot      Decimal                @db.Decimal(12, 2)
  pricingUnitSnapshot    String?                @db.VarChar(32)
  serviceNameSnapshot    String                 @db.VarChar(160)
  serviceModeSnapshot    MarketplaceServiceMode
  waitingMinutesSnapshot Int                    @default(0)
  partnerSubtotal        Decimal                @db.Decimal(12, 2)
  hotelServiceFeeAmount  Decimal                @db.Decimal(12, 2)
  customerTotalAmount    Decimal                @db.Decimal(12, 2)
  currency               String                 @default("VND") @db.Char(3)
  guestNote              String?                @db.VarChar(500)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  order                  MarketplaceOrder       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service                MarketplaceService     @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([serviceId])
}

model MarketplaceOrderEvent {
  id         String                    @id @default(cuid())
  orderId    String
  actorType  MarketplaceOrderActorType
  actorId    String?
  fromStatus MarketplaceOrderStatus?
  toStatus   MarketplaceOrderStatus
  note       String?                   @db.VarChar(500)
  createdAt  DateTime                  @default(now())
  order      MarketplaceOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model MarketplaceRevenueEntry {
  id              String           @id @default(cuid())
  orderId         String           @unique
  hotelId         String
  serviceTenantId String
  grossAmount     Decimal          @db.Decimal(12, 2)
  currency        String           @db.Char(3)
  recognizedAt    DateTime
  createdAt       DateTime         @default(now())
  order           MarketplaceOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([hotelId, recognizedAt])
  @@index([serviceTenantId, recognizedAt])
}

model GuestCart {
  id        String          @id @default(cuid())
  hotelId   String
  stayId    String
  sessionId String          @unique
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  hotel     Hotel           @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  stay      GuestStay       @relation(fields: [stayId], references: [id], onDelete: Cascade)
  session   GuestSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  items     GuestCartItem[]

  @@index([hotelId])
  @@index([stayId])
}

model GuestCartItem {
  id        String             @id @default(cuid())
  cartId    String
  serviceId String
  quantity  Int                @default(1)
  guestNote String?            @db.VarChar(500)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  cart      GuestCart          @relation(fields: [cartId], references: [id], onDelete: Cascade)
  service   MarketplaceService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([cartId, serviceId])
  @@index([cartId])
  @@index([serviceId])
}
