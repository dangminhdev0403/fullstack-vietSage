generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  LOCKED
  DISABLED
}

enum UserType {
  VIETSAGE_ADMIN
  HOTEL_STAFF
  PARTNER
}

enum TenantUserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum HotelStaffAssignmentStatus {
  ACTIVE
  REVOKED
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
  OPTIONS
}

enum UserRoleStatus {
  ACTIVE
  REVOKED
}

enum RoleStatus {
  ACTIVE
  DISABLED
}

enum AuthSessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
  COMPROMISED
}

enum AuthSessionRevokeReason {
  LOGOUT
  LOGOUT_ALL
  USER_DISABLED
  ROLE_CHANGED
  REFRESH_TOKEN_REPLAYED
  SESSION_REPLACED
  SECURITY_EVENT
  EXPIRED
}

enum HotelStatus {
  ACTIVE
  DISABLED
}

enum RoomStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  MAINTENANCE
  OUT_OF_SERVICE
  BLOCKED
  PROCESSING
}

enum RoomQRCodeStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  REVOKED
}

enum GuestStayStatus {
  RESERVED
  CHECKED_IN
  ACTIVE
  CHECKOUT_PENDING
  CHECKED_OUT
  CANCELLED
}

enum ReservationStatus {
  CONFIRMED
  ARRIVAL_READY
  CHECKED_IN
  CANCELLED
  NO_SHOW
}

enum GuestSessionStatus {
  CREATED
  ACTIVE
  IDLE
  EXPIRED
  CLOSED
}

enum GuestRequestStatus {
  NEW
  CONFIRMED
  PENDING
  ACCEPTED
  ON_THE_WAY
  IN_PROGRESS
  COMPLETED
  REJECTED
  CREATED
  ACKNOWLEDGED
  CANCELLED
  FAILED
}

enum GuestRequestPriority {
  NORMAL
  URGENT
}

enum GuestRequestActorType {
  GUEST
  STAFF
  SYSTEM
}

enum NotificationProvider {
  TELEGRAM
}

enum GuestRequestNotificationStatus {
  PENDING
  SENT
  FAILED
}

enum ServiceCatalogStatus {
  ACTIVE
  DISABLED
}

enum CategoryPriceUpdateMode {
  CATEGORY_ONLY
  OVERRIDE_ALL_ITEMS
}

enum DomainEventStatus {
  PENDING
  PROCESSED
  FAILED
}

enum FolioStatus {
  OPEN
  CHECKOUT_PENDING
  CLOSED
  VOID
}

enum FolioItemType {
  SERVICE
  ROOM_CHARGE
  MANUAL_CHARGE
  DISCOUNT
  ADJUSTMENT
}

enum FolioItemSourceType {
  GUEST_REQUEST
  ROOM
  STAY
  MANUAL
  SYSTEM
}

enum GuestRequestBillingPostStatus {
  NONE
  POSTED
  FAILED
}

enum InvoiceStatus {
  ISSUED
  PAID
  VOID
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  MOMO
  VNPAY
  STRIPE
  MANUAL
}

enum PaymentProvider {
  MANUAL
  MOMO
  VNPAY
  STRIPE
  BANK_TRANSFER
}

enum EmergencyLocationSource {
  GPS
  QR
  INVITE
  HOST_SELECTED
  GUEST_SELECTED
  MANUAL_ADDRESS
  TENANT_DEFAULT
  IP_DERIVED
  UNKNOWN
}

enum EmergencyLocationConfidence {
  HIGH
  MEDIUM
  LOW
  UNKNOWN
}

enum EmergencyCallLifecycleStatus {
  ATTEMPTED
  ROUTED
  RINGING
  CONNECTED
  FAILED
  ABANDONED
  COMPLETED
}

enum EmergencyIncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EmergencyIncidentStatus {
  OPEN
  ESCALATING
  ACKNOWLEDGED
  MONITORING
  RESOLVED
  REOPENED
}

enum EmergencyNotificationStatus {
  PENDING
  SENT
  FAILED
  ACKNOWLEDGED
}

enum EmergencyNotificationType {
  INITIAL
  SEVERITY_ESCALATION
  ROOM_UPDATE
  FAILURE
  RESOLUTION
  REOPENED
}

model User {
  id                    String              @id @default(cuid())
  email                 String              @unique @db.VarChar(320)
  passwordHash          String              @db.VarChar(255)
  fullName              String              @db.VarChar(120)
  status                UserStatus          @default(ACTIVE)
  userType              UserType
  lastLoginAt           DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  userRoles             UserRole[]
  refreshTokens         RefreshToken[]
  authSessions          AuthSession[]
  tenantUsers           TenantUser[]
  hotelAssignments      HotelStaffAssignment[] @relation("HotelStaffAssignmentUser")
  assignedHotelStaff    HotelStaffAssignment[] @relation("HotelStaffAssignmentAssignedBy")
  revokedHotelStaff     HotelStaffAssignment[] @relation("HotelStaffAssignmentRevokedBy")
  auditLogs             AuditLog[]          @relation("AuditActor")
  createdStays          GuestStay[]         @relation("GuestStayCreatedBy")
  closedStays           GuestStay[]         @relation("GuestStayClosedBy")
  assignedGuestRequests GuestRequest[]      @relation("GuestRequestAssignedTo")
  guestRequestEvents    GuestRequestEvent[] @relation("GuestRequestEventActor")
  sentGuestMessages     GuestMessage[]      @relation("GuestMessageStaffSender")
  createdFolios         Folio[]             @relation("FolioCreatedBy")
  closedFolios          Folio[]             @relation("FolioClosedBy")
  postedFolioItems      FolioItem[]         @relation("FolioItemPostedBy")
  voidedFolioItems      FolioItem[]         @relation("FolioItemVoidedBy")
  issuedInvoices        Invoice[]           @relation("InvoiceIssuedBy")
  paidInvoices          Invoice[]           @relation("InvoicePaidBy")
  voidedInvoices        Invoice[]           @relation("InvoiceVoidedBy")
  createdPayments       Payment[]           @relation("PaymentCreatedBy")
}

model Role {
  id              String           @id @default(cuid())
  code            String           @unique @db.VarChar(80)
  name            String           @db.VarChar(120)
  description     String?          @db.VarChar(255)
  status          RoleStatus       @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@index([status])
}

model Permission {
  id              String           @id @default(cuid())
  method          HttpMethod
  moduleKey       String           @db.VarChar(80)
  path            String           @db.VarChar(255)
  description     String           @db.VarChar(255)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]

  @@unique([method, path])
  @@index([moduleKey, method, path])
}

model Code {
  id           String   @id @default(cuid())
  name         String   @unique @db.VarChar(80)
  sequenceNext Int      @default(1)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([name])
  @@index([isActive])
}

model UserRole {
  id           String         @id @default(cuid())
  userId       String
  roleId       String
  status       UserRoleStatus @default(ACTIVE)
  assignedAt   DateTime       @default(now())
  assignedById String?
  revokedAt    DateTime?
  revokedById  String?
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role           @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId, status])
  @@index([roleId, status])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique @db.VarChar(255)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuthSession {
  id                 String                    @id @default(cuid())
  userId             String
  roleId             String
  status             AuthSessionStatus         @default(ACTIVE)
  currentRefreshHash String                    @unique @db.VarChar(255)
  refreshFamilyId    String                    @db.VarChar(64)
  version            Int                       @default(1)
  idleExpiresAt      DateTime
  absoluteExpiresAt  DateTime
  lastUsedAt         DateTime                  @default(now())
  rotatedAt          DateTime?
  revokedAt          DateTime?
  revokeReason       AuthSessionRevokeReason?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHistory     AuthRefreshTokenHistory[]
  refreshIdempotency AuthRefreshIdempotency[]

  @@index([userId, status])
  @@index([refreshFamilyId, status])
  @@index([status, idleExpiresAt])
  @@index([status, absoluteExpiresAt])
}

model AuthRefreshTokenHistory {
  id        String      @id @default(cuid())
  sessionId String
  tokenHash String      @unique @db.VarChar(255)
  expiresAt DateTime
  createdAt DateTime    @default(now())
  session   AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([expiresAt])
}

model AuthRefreshIdempotency {
  id                 String      @id @default(cuid())
  sessionId          String
  idempotencyKey     String      @db.VarChar(64)
  requestFingerprint String      @db.VarChar(64)
  encryptedResult    String      @db.Text
  expiresAt          DateTime
  createdAt          DateTime    @default(now())
  session            AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, idempotencyKey])
  @@index([expiresAt])
}

model Tenant {
  id                  String               @id @default(cuid())
  code                String               @unique @db.VarChar(80)
  name                String               @db.VarChar(160)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  tenantUsers         TenantUser[]
  auditLogs           AuditLog[]
  hotels              Hotel[]
  emergencyLocations  EmergencyLocation[]
  emergencyCallEvents EmergencyCallEvent[]
  emergencyIncidents  EmergencyIncident[]
}

model TenantUser {
  id        String           @id @default(cuid())
  tenantId  String
  userId    String
  status    TenantUserStatus @default(INVITED)
  joinedAt  DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId, status])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  tenantId   String
  action     String   @db.VarChar(120)
  entityType String   @db.VarChar(120)
  entityId   String?  @db.VarChar(120)
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([actorId, createdAt])
  @@index([tenantId, createdAt])
}

model Hotel {
  id                  String                 @id @default(cuid())
  tenantId            String
  name                String                 @db.VarChar(160)
  code                String                 @db.VarChar(80)
  brandSettings       Json?
  googleSheetId       String?                @unique @db.VarChar(200)
  timezone            String                 @default("Asia/Saigon") @db.VarChar(80)
