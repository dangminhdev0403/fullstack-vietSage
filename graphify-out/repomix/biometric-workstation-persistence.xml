  path            String           @db.VarChar(255)
  description     String           @db.VarChar(255)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]

  @@unique([method, path])
  @@index([moduleKey, method, path])
