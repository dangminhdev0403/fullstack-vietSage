ON CONFLICT ("code") DO UPDATE SET "name" = EXCLUDED."name", "type" = 'SERVICE', "updatedAt" = now();

WITH base AS (
  SELECT COALESCE("latitude", 10.776900)::numeric AS lat, COALESCE("longitude", 106.700900)::numeric AS lon
