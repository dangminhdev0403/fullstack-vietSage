{
  "openapi": "3.1.0",
  "info": {
    "title": "KBTT Accommodation Establishment API",
    "version": "1.4-normalized",
    "description": "Agent-ready normalization of the provider PDF for third-party accommodation establishments. The supplied filename says v1.3 while the cover says v1.4 (August 2026). This contract intentionally omits all sample credentials and tokens. Provider business success is determined by JSON body code == \"200\", not HTTP status alone.",
    "x-source": {
      "document": "HD_Tichhop-API-CSLT-v1.3.docx.pdf",
      "coverVersion": "1.4",
      "coverDate": "2026-08",
      "pages": 20,
      "sha256": "fee9fcd523e7e963326cc93e94fe26f0c9e68b4ac42d7fd60eb4000cdc24d195"
    }
  },
  "servers": [
    {
      "url": "https://api-tbltkbtt.bocongan.gov.vn",
      "description": "Production"
    },
    {
      "url": "https://api-kbtt.ai-vlab.com",
      "description": "Provider demo"
    }
  ],
  "tags": [
    {
      "name": "Authentication",
      "description": "Provider token lifecycle."
    },
    {
      "name": "Declarations",
      "description": "Guest declaration submission."
    },
    {
      "name": "Catalogs",
      "description": "Public provider reference catalogs."
    },
    {
      "name": "Domestic stay changes",
      "description": "Departure/extension changes for Vietnamese guests only."
    }
  ],
  "paths": {
    "/authorization-service/oauth/token": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "operationId": "getKbttToken",
        "summary": "Get access and refresh tokens",
        "security": [
          {
            "providerLoginBasic": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "username",
                  "password",
                  "grant-type"
                ],
                "properties": {
                  "username": {
                    "type": "string",
                    "minLength": 1
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "minLength": 1,
                    "writeOnly": true
                  },
                  "grant-type": {
                    "type": "string",
                    "const": "api_cslt"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Provider response. Success requires body.code == \"200\".",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/TokenEnvelope"
                    },
                    {
                      "$ref": "#/components/schemas/BusinessErrorEnvelope"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/authorization-service/oauth/refresh-token": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "operationId": "refreshKbttToken",
        "summary": "Refresh an expiring session",
        "security": [
          {
            "providerTokenBasic": []
          }
        ],
        "parameters": [
          {
            "name": "refresh_token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "writeOnly": true
            },
            "description": "RefreshToken from token/refresh response. Redact query strings from logs."
          }
        ],
        "responses": {
          "200": {
            "description": "Provider response. Success requires body.code == \"200\".",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/TokenEnvelope"
                    },
                    {
                      "$ref": "#/components/schemas/BusinessErrorEnvelope"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/authorization-service/oauth/revoke": {
      "delete": {
        "tags": [
          "Authentication"
        ],
        "operationId": "revokeKbttToken",
        "summary": "Revoke an access token",
        "security": [
          {
            "providerTokenBasic": []
          }
        ],
        "parameters": [
          {
            "name": "access_token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "writeOnly": true
            },
            "description": "AccessToken to revoke. Redact query strings from logs."
          }
        ],
        "responses": {
          "200": {
            "description": "Provider response. Success requires body.code == \"200\".",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/SuccessEnvelope"
                    },
                    {
                      "$ref": "#/components/schemas/BusinessErrorEnvelope"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
