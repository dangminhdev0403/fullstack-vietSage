                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/SuccessEnvelope"
                    },
                    {
                      "$ref": "#/components/schemas/BusinessErrorEnvelope"
                    }
                  ]
                }
              }
            }
          }
        },
        "x-provider-behavior": [
          "Business errors may identify entries by 1-based array position.",
          "No idempotency key or read-back endpoint is documented."
        ]
      }
    },
