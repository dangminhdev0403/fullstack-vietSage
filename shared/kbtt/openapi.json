  "components": {
    "securitySchemes": {
      "providerLoginBasic": {
        "type": "http",
        "scheme": "basic",
        "description": "Provider-issued client credential for token login. Never hard-code it."
      },
      "providerTokenBasic": {
        "type": "http",
        "scheme": "basic",
        "description": "Provider-issued client credential for refresh/revoke. Never hard-code it."
      },
      "providerBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque",
        "description": "AccessToken returned by get/refresh token."
      }
    },
    "schemas": {
      "TokenSession": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "AccessToken",
          "RefreshToken",
          "TokenType",
          "Exp",
          "Authorities",
          "ClientId",
          "LoaiTK",
          "CsltId",
          "CsltKhuVuc",
          "CsltDonVi",
          "MaTTCuaCslt",
          "MaPxCuaCslt",
          "IsCsltChinh"
        ],
        "properties": {
          "AccessToken": {
            "type": "string",
            "minLength": 1,
            "writeOnly": true
          },
          "RefreshToken": {
            "type": "string",
            "minLength": 1,
            "writeOnly": true
          },
          "TokenType": {
            "type": "string",
            "const": "bearer"
          },
          "Exp": {
            "type": "integer",
            "format": "int64",
            "description": "Unix timestamp in seconds."
          },
          "Authorities": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Must include kbtt:create-3th before declaration submission."
          },
          "ClientId": {
            "type": "integer"
          },
          "LoaiTK": {
            "type": "string",
            "const": "CSLT"
          },
          "CsltId": {
            "type": "string"
          },
          "CsltKhuVuc": {
            "type": "integer"
          },
          "CsltDonVi": {
            "type": "integer"
          },
          "MaTTCuaCslt": {
            "type": "string"
          },
          "MaPxCuaCslt": {
            "type": "string"
          },
          "IsCsltChinh": {
            "type": "boolean"
          }
        }
      },
      "TokenEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "data"
        ],
        "properties": {
          "code": {
            "type": "string",
            "const": "200"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/TokenSession"
          }
        }
      },
      "SuccessEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "data"
        ],
        "properties": {
          "code": {
            "type": "string",
            "const": "200"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "null"
          }
        }
      },
      "BusinessErrorEnvelope": {
        "type": "object",
        "required": [
          "code",
          "message",
          "data"
        ],
        "properties": {
          "code": {
            "type": "string",
            "not": {
              "const": "200"
            }
          },
          "message": {
            "type": "string"
          },
          "data": {}
        },
        "description": "Provider business failure. The transport status may still be HTTP 200."
      },
      "ForeignGuestDeclaration": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hoTen",
          "quocTich",
          "soHoChieu",
          "gioiTinh",
          "loaiNgayThangNamSinh",
          "ngayThangNamSinhStr",
          "ngayDenCsltStr",
          "ngayDiDuKienStr",
          "thoiHanTamTruStr"
        ],
        "properties": {
          "hoTen": {
            "type": "string",
            "minLength": 1,
            "description": "Full name."
          },
          "quocTich": {
            "type": "string",
            "minLength": 1,
            "description": "Provider country code from the nationality catalog; do not assume ISO."
          },
          "soHoChieu": {
            "type": "string",
            "minLength": 1,
            "description": "Passport or identity-document number."
          },
          "gioiTinh": {
            "type": "string",
            "enum": [
              "M",
              "F"
            ]
          },
          "loaiNgayThangNamSinh": {
            "type": "string",
            "enum": [
              "D",
              "Y"
            ],
            "description": "D = full date; Y = year only, represented as YYYY-01-01."
          },
          "ngayThangNamSinhStr": {
            "$ref": "#/components/schemas/Date"
          },
          "ngayDenCsltStr": {
            "$ref": "#/components/schemas/LocalDateTime"
          },
          "ngayDiDuKienStr": {
            "$ref": "#/components/schemas/LocalDateTime"
          },
          "soPhong": {
            "type": "string",
            "description": "Conditionally required for provider-listed accommodation types, including hotels/guesthouses."
          },
          "anhHoChieuB64": {
            "type": "string",
            "contentEncoding": "base64",
            "description": "Optional JPEG/PNG passport image."
          },
          "thoiHanTamTruStr": {
            "$ref": "#/components/schemas/LocalDateTime"
          }
        }
      },
      "DomesticGuestDeclaration": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hoTen",
          "gioiTinh",
          "ngayThangNamSinhStr",
          "ngayDenCsltStr",
          "ngayDiDuKienStr",
          "lyDoCuTru",
          "loaiGiayTo",
          "soGiayTo"
        ],
        "properties": {
          "hoTen": {
            "type": "string",
            "minLength": 1
          },
          "gioiTinh": {
            "type": "string",
            "enum": [
              "M",
              "F"
            ]
          },
          "soDienThoai": {
            "type": "string"
          },
          "ngayThangNamSinhStr": {
            "$ref": "#/components/schemas/Date"
          },
          "ghiChu": {
            "type": "string"
          },
          "noiCuTru": {
            "type": "integer",
            "format": "int64",
            "description": "ID from residence-place catalog."
          },
          "maTT": {
            "type": "string",
            "description": "Province/city code from province catalog."
          },
          "maPX": {
            "type": "string",
            "description": "Ward/commune code from ward catalog."
          },
          "diaChi": {
            "type": "string"
          },
          "ngayDenCsltStr": {
            "$ref": "#/components/schemas/LocalDateTime"
          },
          "ngayDiDuKienStr": {
            "$ref": "#/components/schemas/LocalDateTime"
          },
          "soPhong": {
            "type": "string",
            "description": "Conditionally required for provider-listed accommodation types, including hotels/guesthouses."
          },
          "lyDoCuTru": {
            "type": "integer",
            "format": "int64",
            "description": "ID from stay-reason catalog."
          },
          "lyDoChiTiet": {
            "type": "string",
            "description": "Has value only when lyDoCuTru == 20."
          },
          "loaiGiayTo": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8,
            "description": "ID from document-type catalog."
          },
          "soGiayTo": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]+$",
            "description": "No spaces or special characters; type-specific rules also apply."
          },
          "anhTruocB64": {
            "type": "string",
            "contentEncoding": "base64",
            "description": "Optional JPEG/PNG front image. Passport images use this field when loaiGiayTo == 4."
          },
          "anhSauB64": {
            "type": "string",
            "contentEncoding": "base64",
            "description": "Optional JPEG/PNG back image."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "lyDoCuTru": {
                  "const": 20
                }
              },
              "required": [
                "lyDoCuTru"
              ]
            },
            "then": {
              "required": [
                "lyDoChiTiet"
              ],
              "properties": {
                "lyDoChiTiet": {
                  "minLength": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "loaiGiayTo": {
                  "enum": [
                    1,
                    8
                  ]
                }
              },
              "required": [
                "loaiGiayTo"
              ]
            },
            "then": {
              "properties": {
                "soGiayTo": {
                  "pattern": "^[0-9]{12}$"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "loaiGiayTo": {
                  "const": 2
                }
              },
              "required": [
                "loaiGiayTo"
              ]
            },
            "then": {
              "properties": {
                "soGiayTo": {
                  "pattern": "^(?:[0-9]{9}|[0-9]{12})$"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "loaiGiayTo": {
                  "const": 3
                }
              },
              "required": [
                "loaiGiayTo"
              ]
            },
            "then": {
              "properties": {
                "soGiayTo": {
                  "maxLength": 20
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "loaiGiayTo": {
                  "const": 4
                }
              },
              "required": [
                "loaiGiayTo"
              ]
            },
            "then": {
              "properties": {
                "soGiayTo": {
                  "maxLength": 10
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "loaiGiayTo": {
                  "const": 6
                }
              },
              "required": [
                "loaiGiayTo"
              ]
            },
            "then": {
              "properties": {
                "soGiayTo": {
                  "maxLength": 20
                }
              }
            }
          }
        ]
      },
      "DomesticDepartureChange": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "loai",
          "soGiayTo",
          "loaiGiayTo"
        ],
        "properties": {
          "loai": {
            "type": "string",
            "enum": [
              "TS",
              "GH"
            ],
            "description": "TS = early departure; GH = extension."
          },
          "soGiayTo": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]+$"
          },
          "loaiGiayTo": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "thoiGianStr": {
            "$ref": "#/components/schemas/LocalDateTime"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "loai": {
                  "const": "GH"
                }
              },
              "required": [
                "loai"
              ]
            },
            "then": {
              "required": [
                "thoiGianStr"
              ]
            }
          }
        ],
        "x-validation-notes": [
          "No duplicate document numbers in one request.",
          "For GH, the new date cannot exceed 30 days from arrival.",
          "Document-number rules match DomesticGuestDeclaration."
        ]
      },
      "Country": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "maQT",
          "tenQT",
          "tenQTEn"
        ],
        "properties": {
          "maQT": {
            "type": "string"
          },
          "tenQT": {
            "type": "string"
          },
          "tenQTEn": {
            "type": "string"
          }
        }
      },
      "Province": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "maTT",
          "tenTT",
          "tenTTEn"
        ],
        "properties": {
